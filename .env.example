# ExecutiveOS runtime secrets — TEMPLATE.
# Copy this file to `.env` and fill in the real values. `.env` is gitignored; this file is committed.
# Bun auto-loads `.env` into process.env, so the `work` command picks these up with no code changes.

# Auth token for the worker LLM gateway.
# The env var NAME must match config.worker.apiKeyEnv in .executive/config.json (default below).
EXECUTIVE_WORKER_KEY=
